# Copy to .env in the project folder on the server and fill in. Never commit the real .env.

# The site's domain; its DNS A record must point to the server's static IP.
PDD_DOMAIN=pidi.example.com

# The server's OpenAI key: used for projects of people who haven't connected a key of their own.
# Set a monthly budget limit for it in the OpenAI dashboard.
OPENAI_API_KEY=sk-...

# One user: create the account with `docker compose exec app python -m web.create_user you@example.com`
# and keep sign-up closed, so nobody else can create an account.
PDD_ALLOW_SIGNUP=false

# Optional:
# PDD_ALLOW_SERVER_KEY=false   # require everyone to connect their own key
# PDD_MAX_UPLOAD_MB=2048       # largest recording accepted
# PDD_SESSION_DAYS=7           # how long a login lasts
